# =======================================
# Telegram Bot Configuration
# =======================================

# Токен вашего Telegram бота (получите у @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ID администратора бота (ваш Telegram ID)
# Узнать можно у @userinfobot
ADMIN_ID=123456789

# Username администратора (без @)
ADMIN_USERNAME=your_username


# =======================================
# Payment Configuration
# =======================================

# Реквизиты для приема платежей
PAYMENT_DC_CARD=5536914096627215
PAYMENT_ESKHATA_CARD=2022919700000000
PAYMENT_ALIF_CARD=3011591000000000
PAYMENT_VISA_CARD=5536914096627215


# =======================================
# Database Configuration
# =======================================

# Database URL (SQLite по умолчанию)
DATABASE_URL=sqlite:///data/bot.db

# SQL Echo (показывать SQL запросы в логах)
SQL_ECHO=false


# =======================================
# Logging Configuration
# =======================================

# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Sentry DSN для мониторинга ошибок (опционально)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id


# =======================================
# Security Configuration
# =======================================

# Максимум запросов от пользователя в минуту
RATE_LIMIT_PER_MINUTE=30

# Webhook секрет (если используете webhook вместо polling)
# WEBHOOK_SECRET=your-webhook-secret-key


# =======================================
# Environment
# =======================================

# Режим работы (development, production)
ENVIRONMENT=production

# Debug режим (true/false)
DEBUG=false
